# Local development defaults to SQLite. Docker Compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL=sqlite:///./trustthread.db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
APP_ENV=demo
LLM_MODE=mock
# Optional future real LLM integration:
# LLM_API_URL=https://your-openai-compatible-endpoint/v1/chat/completions
# LLM_API_KEY=your-key
# LLM_MODEL=your-model
